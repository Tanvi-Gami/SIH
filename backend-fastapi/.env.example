DATABASE_URL=postgresql://sih_user:sih_password@localhost:5432/sih_platform

# Optional — if unset, the platform automatically uses MockAIProvider so the
# demo works fully offline. Set this to enable real OpenAI-powered analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional — if unset, the platform automatically uses a local TF-IDF based
# MockVectorProvider instead of Pinecone.
PINECONE_API_KEY=
PINECONE_INDEX=sih-platform
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

EXPRESS_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173
